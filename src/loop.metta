(= (maxNewInputLoops) (empty))
(= (maxWakeLoops) (empty))
(= (sleepInterval) (empty))
(= (provider) (empty))
(= (maxOutputToken) (empty))
(= (reasoningMode) (empty))
(= (wakeupInterval) (empty))
(= (memoryDirectory) (empty))
(= (spamShield) (empty)) ; TODO: this parameter is considered deprecated

(= (initLoop)
   (progn (configure maxNewInputLoops 50) ;20
          (configure maxWakeLoops 1)
          (configure spamShield False)
          (configure sleepInterval 1) ;10
          (configure provider Anthropic)
          (configure maxOutputToken 6000)
          (configure reasoningMode medium)
          (configure wakeupInterval 600) ;600=10 minutes
          (configure memoryDirectory
               (joinPath ((py-call (helper.projectRootDirectory)) memory)))
          (change-state! &prevmsg "")
          (change-state! &lastresults "")
          (change-state! &loops 0)
          (change-state! &turnStatus "idle")
          (change-state! &error ())
          ))

(= (initKnowledge)
   (progn (log INFO "loop" "Initializing knowledge base")
          (log INFO "loop" (py-call (rag.init_knowledge (embeddingprovider))))
          ()))

; Context is data passed directly through py-call, not generated MeTTa code.
; Preserve literal quotes/newlines/Unicode and literal legacy placeholder tokens.
(= (getContext)
   (py-str ("PROMPT: " (getPrompt (provider)) " SKILLS: " (getSkills)
                         (newline) (getPromptExtensions) (newline)
                         " OUTPUT_FORMAT: When function tools are supplied, invoke skills through those tools. Final assistant text is delivered literally; commentary is not final. For legacy command providers only: up to 5 command lines, no variables:" (newline)
                         " toolName1 arg1" (newline)
                         " toolName2 arg2" (newline)
                         " toolName3 arg3" (newline)
                         " toolName4 arg4" (newline)
                         " toolName5 arg5" (newline)
                         " SAVE_PERMANENT_FILES_DIR: " (memoryDirectory)
                         " LAST_SKILL_USE_RESULTS: " (last_chars (get-state &lastresults) (maxFeedback))
                         " HISTORY: " (getHistory) 
                         " TIME: " (get_time_as_string))))

(= (addTelegramPromptExtension)
   (if (== (commchannel) telegram)
       (let $path (joinPath ((memoryDirectory) "tg_prompt.txt"))
            (if (exists-file $path)
                (add-prompt-extension tg-prompt (read-file $path))
                (progn (log WARN "loop" (TELEGRAM_PROMPT_NOT_FOUND: $path))
                       ())))
       ()))

(= (getPromptExtensions)
   (join (newline) (collapse (prompt-extension $_))))

; dynamic prompt extension placeholder to eliminate error when no extension is added
(= (prompt-extension placeholder) (empty))

(= (HandleError $msg $cmd $sexpr)
   (case $sexpr (((Error $a $b) (let $new (append (get-state &error) (($msg $cmd)))
                                          (progn (change-state! &error $new) (ALERT_FAILED $a $b))))
                 ($else $sexpr))))

; Response dispatch, effect ordering and continuation are native decisions.
; The host exposes validated data and performs only transport/replay.
(= (turn-stop $status)
   (progn (change-state! &turnStatus $status)
          (change-state! &loops 0)
          (let $replay (py-call (providers.llmProviderEndTurn (repr $status)))
            (if (== $replay recorded) ()
                (change-state! &turnStatus (REPLAY_ERROR $status))))
          (log INFO "loop" (TURN_STATUS (get-state &turnStatus)))
          (appendToHistory ((get_time_as_string) TURN_STATUS (get-state &turnStatus)))))

(= (turn-deliver $text $status)
   (progn
     ; Mark terminal before the send: a failed/uncertain send must not be retried.
     (change-state! &loops 0)
     (let $delivery (catch (commChannelSend $text))
       (case $delivery
         (((Error $a $b) (turn-stop DELIVERY_UNCERTAIN))
          ((Error $a) (turn-stop DELIVERY_UNCERTAIN))
          ($ok (turn-stop $status)))))))

; Invoke one registered native symbol with literal string arguments. No sread
; of assistant content and no generated program text crosses this boundary.
(= (invoke-response-call ($id $name $arguments))
   (progn
     (translatePredicate (atom_string $symbol $name))
     (let* (($command (cons-atom $symbol $arguments))
            ($results (collapse (catch (eval $command)))))
       (cons-atom $id (cons-atom $results ())))))

(= (execute-response-calls $calls)
   (if (== $calls ())
       ()
       (let* (($result (invoke-response-call (car-atom $calls)))
              ($rest (execute-response-calls (cdr-atom $calls))))
         (cons-atom $result $rest))))

(= (serialize-tool-results $results)
   (if (== $results ())
       ()
       (let* ((($id $values) (car-atom $results))
              ($text (repr $values))
              ($rest (serialize-tool-results (cdr-atom $results))))
         (cons-atom (cons-atom $id (cons-atom $text ())) $rest))))

(= (continue-turn $status)
   (progn (change-state! &turnStatus $status)
          (if (<= (get-state &loops) 0)
              (turn-stop (BUDGET_EXHAUSTED $status))
              ())))

(= (dispatch-completed $response)
   (let* (($calls (response-field $response "calls"))
          ($final (response-field $response "final_text"))
          ($refusal (response-field $response "refusal"))
          ($commentary (response-field $response "commentary")))
     (if (> (string_length $refusal) 0)
         (turn-deliver $refusal "refusal")
         (if (!= $calls ())
             (let* (($results (execute-response-calls $calls))
                    ($_ (change-state! &lastresults (repr $results)))
                    ($_ (appendToHistory (TOOL_RESULTS $results)))
                    ($replay (py-call (providers.llmProviderToolResults (serialize-tool-results $results)))))
               (if (== $replay recorded)
                   (continue-turn "tool_results")
                   (turn-stop "replay_error")))
             (if (> (string_length $final) 0)
                 (turn-deliver $final "completed")
                 (if (> (string_length $commentary) 0)
                     (continue-turn "commentary")
                     (continue-turn "empty")))))))

(= (dispatch-response $response)
   (let $status (response-field $response "status")
     (if (== $status completed)
         (dispatch-completed $response)
         (turn-stop $status))))

(= (omega)
   (omega 1))
(= (omega $k)
   (progn
     (if (== $k 1)
         (progn (initConfig) (initLoop) (initLogger) (applySecurityPolicy)
                (initMemory) (initKnowledge) (initPlugins) (initChannels)
                (addTelegramPromptExtension)
                (catch (commChannelSend (version)))
                (llmProviderStart (provider)))
         ())
     (log INFO "loop" (---------iteration $k))
     (heartbeat $k)
     ; Receive before context; each nonempty receive is a new input, even if
     ; its text equals a previous input. Idle never calls the provider.
     (let $input (receive)
       (progn
         (if (> (string_length $input) 0)
             (progn (change-state! &prevmsg $input)
                    (change-state! &lastresults "")
                    (change-state! &lastsend "")
                    (change-state! &error ())
                    (change-state! &loops (py-call (int (maxNewInputLoops))))
                    (change-state! &turnStatus "active")
                    (appendToHistory ((get_time_as_string) HUMAN_MESSAGE: $input))
                    (if (py-call (providers.provider_ready))
                        () (llmProviderStart (provider))))
             ())
         (if (> (get-state &loops) 0)
             (let* (($_ (change-state! &loops (- (get-state &loops) 1)))
                    ($context (getContext))
                    ($prompt (py-str ($context :-:-:-: $input)))
                    ($response (llmProviderRespond $prompt (maxOutputToken) (reasoningMode)))
                    ($_ (appendToHistory (PROVIDER_RESPONSE (py-call (providers.response_record $response))))))
               (dispatch-response $response))
             ())
         (sleep (py-call (float (sleepInterval))))
         (cut)
         (gc)
         (omega (+ 1 $k))))))
